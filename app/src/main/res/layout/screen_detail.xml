<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_overlay_card_title"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/detail_placeholder_description"
            android:textColor="#475569"
            android:textSize="15sp" />

        <com.mspoverlay.android.overlay.render.OverlayPreviewView
            android:id="@+id/detailPreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="18dp"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/detail_placeholder_meta"
            android:textColor="#334155"
            android:textSize="15sp" />

        <Button
            android:id="@+id/detailApplyButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/action_apply_overlay" />

        <Button
            android:id="@+id/detailSaveButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/action_save_to_library" />
    </LinearLayout>
</ScrollView>
