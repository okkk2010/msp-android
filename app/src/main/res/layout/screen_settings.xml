<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/settingsAccountState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_login_unknown"
            android:textColor="#334155"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settingsLoginButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/action_google_login" />

        <Button
            android:id="@+id/settingsLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/action_logout" />

        <TextView
            android:id="@+id/settingsApiBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#334155"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settingsOverlayPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/action_open_overlay_permission" />

        <Button
            android:id="@+id/settingsNotificationPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/action_request_notification_permission" />

        <Button
            android:id="@+id/settingsClearCacheButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/action_clear_cache" />
    </LinearLayout>
</ScrollView>
